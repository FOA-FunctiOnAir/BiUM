{
  "BiAppOptions": {
    "Environment": "Development",
    "Domain": "Test",
    "DomainVersion": "v1",
    "Port": 5000
  },
  "BoltOptions": {
    "Enable": true,
    "Branch": "Local",
    "Server": "/api/bolt/BoltEntity/SaveFwBoltEntity",
    "ConnectionString": "Host=prod.bolt.db.postgres.bidyno.com; Port=30544; Database={0}; Username=postgres; Password=password;"
  },
  "DatabaseType": "PostgreSQL",
  "ConnectionStrings": {
    "MSSQL": "Server=(localdb)\\mssqllocaldb;Database=BiAppAuthDb;Trusted_Connection=True;MultipleActiveResultSets=true",
    "PostgreSQL": "Host=dev.shared.db.postgres.bidyno.com; Port=30543; Database=bium-test; Username=postgres; Password=password;"
  },
  "RedisOptions": {
    "Default": {
      "Enable": true,
      "DefaultCacheTimeout": "3000",
      "ConnectionString": "38.242.253.6:30078, password=mypassword, abortConnect=false"
    },
    "Gateway": {
      "Enable": false,
      "DefaultCacheTimeout": "3000",
      "ConnectionString": "38.242.253.6:30078, defaultDatabase=1, password=mypassword, abortConnect=false"
    }
  },
  "RabbitMQOptions": {
    "Default": {
      "Enable": true,
      "Hostname": "dev.amqp.bidyno.com",
      "Port": 30672,
      "VirtualHost": "",
      "Username": "myuser",
      "Password": "mypassword"
    }
  },
  "DynamicExporterOptions": {
    "ExportStoragePath": "/tmp/dynamic-exports"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
